{
  "productName": "WhatsApp-QT",
  "version": "0.1.0",
  "identifier": "dev.mj.whatsapp-qt",
  "build": { "frontendDist": "./ui" },
  "app": { "windows": [], "withGlobalTauri": true, "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; connect-src ipc: http://ipc.localhost" } },
  "plugins": { "deep-link": { "desktop": { "schemes": ["whatsapp"] } } },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/icon.png"],
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "14.0" }
  }
}
