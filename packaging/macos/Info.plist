<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: build-macos-app.sh substitutes @VERSION@ from Cargo.toml. -->
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>WhatsApp QT</string>
    <key>CFBundleDisplayName</key>
    <string>WhatsApp QT</string>
    <key>CFBundleIdentifier</key>
    <string>io.github.mrdoom.WhatsAppQT</string>
    <key>CFBundleExecutable</key>
    <string>WhatsApp-QT</string>
    <key>CFBundleIconFile</key>
    <string>WhatsApp-QT.icns</string>
    <key>CFBundleVersion</key>
    <string>@VERSION@</string>
    <key>CFBundleShortVersionString</key>
    <string>@VERSION@</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleSignature</key>
    <string>????</string>
    <key>LSMinimumSystemVersion</key>
    <string>11.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- Registers whatsapp:// with LaunchServices. NOTE: macOS delivers the URL as
         an Apple Event (application:openURLs:), NOT as argv, and the Rust side only
         reads argv - so this makes the app the handler but the URL itself is not
         consumed yet. See CLAUDE.md > Packaging. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>WhatsApp Link</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>whatsapp</string>
            </array>
        </dict>
    </array>
    <!-- WhatsApp Web needs mic/camera for voice and video calls. -->
    <key>NSMicrophoneUsageDescription</key>
    <string>WhatsApp QT needs microphone access for voice and video calls.</string>
    <key>NSCameraUsageDescription</key>
    <string>WhatsApp QT needs camera access for video calls.</string>
</dict>
</plist>
